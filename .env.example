# Clive Environment Configuration

# Anthropic API key for the local fallback personality engine
ANTHROPIC_API_KEY=

# ElevenLabs API key for text-to-speech
ELEVENLABS_API_KEY=

# ElevenLabs voice ID (default: "Drew" - calm male)
# Browse voices at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=YLbQE9U7P1K6rBNJWNSv
CLIVE_TTS_SPEED=1.2

# Resemble AI replacement for cloud TTS
RESEMBLE_API_KEY=
RESEMBLE_VOICE_UUID=bec88a80
RESEMBLE_MODEL=chatterbox-turbo
RESEMBLE_SAMPLE_RATE=22050

# Picovoice access key for wake word (Porcupine)
# Get free key at https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=

# Path to custom "Hey Clive" Porcupine keyword file (.ppn)
# Generate at https://console.picovoice.ai/ppn
PORCUPINE_KEYWORD_PATH=

# Host server port
HOST_PORT=3100

# Host WebSocket URL (Pi client connects to this)
HOST_WS_URL=ws://localhost:3100

# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Whisper device: cpu or cuda
WHISPER_DEVICE=cpu

# Claude model for the fallback personality engine
CLIVE_MODEL=claude-sonnet-4-6

# OpenClaw is Clive's primary mind.
OPENCLAW_AGENT=main
OPENCLAW_TIMEOUT=120
OPENCLAW_STATUS_LABEL=Clive is thinking
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_SESSION_USER=clive-voice-v2

# If OpenClaw is unavailable, fall back to the local personality engine.
CLIVE_FALLBACK_TO_LOCAL_LLM=1

# Mock modes for development (set to 1 to enable)
MOCK_STT=0
MOCK_TTS=0
MOCK_LLM=0
MOCK_AGENT=0
