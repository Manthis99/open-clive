# Copy to /etc/default/clive-pi on the Raspberry Pi.

CLIVE_PROJECT_DIR=/home/pi/open-clive

# Mac/host machine that runs host-server.
CLIVE_HOSTNAME=192.168.1.50
CLIVE_HOST_HTTP_URL=http://192.168.1.50:3100
CLIVE_HOST_WS_URL=ws://192.168.1.50:3100
CLIVE_LISTENER_HOST=ws://192.168.1.50:3100

# Listener tuning.
CLIVE_WAKE_WORD=hey clive
CLIVE_WAKE_SENSITIVITY=7
CLIVE_LISTENER_VAD=rms
# CLIVE_LISTENER_MODELS_DIR=/home/pi/open-clive/clive-listener/models

# Touchscreen kiosk.
DISPLAY=:0
XAUTHORITY=/home/pi/.Xauthority
CHROMIUM_BIN=/usr/bin/chromium-browser
CLIVE_UI_URL=http://localhost:3000
