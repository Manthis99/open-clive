[Unit]
Description=Clive Pi UI server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
EnvironmentFile=-/etc/default/clive-pi
ExecStart=/bin/bash -lc 'cd "$CLIVE_PROJECT_DIR/pi-client" && npm start'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
