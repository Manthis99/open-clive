# Clive Desktop — GPU Configuration (Windows + 2080 TI)
# Copy this to .env and fill in your keys.
# The desktop launcher reads from .env in the project root.

# ---- GPU Configuration ----
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# STT: faster-whisper with CUDA acceleration
WHISPER_DEVICE=cuda
WHISPER_MODEL=small
WHISPER_PERSISTENT=1

# TTS: CSM (Conversational Speech Model) on GPU
CSM_ENABLED=1
CSM_DEVICE=cuda
CSM_MAX_CONTEXT_TURNS=5
CSM_MAX_AUDIO_LENGTH_MS=10000
CSM_SPEAKER_ID=0

# Voice seed: anchors CSM to a consistent voice identity.
# Path is relative to project root. See shared/voice-seed/ for options.
CSM_VOICE_SEED=shared/voice-seed/seed_au_william_24k.wav
CSM_VOICE_SEED_TEXT=Good morning. How can I help you today?

# ---- API Keys (same as Pi version) ----

# Anthropic API key for fallback personality engine
ANTHROPIC_API_KEY=

# ElevenLabs (fallback if CSM fails — optional)
#ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD

# OpenClaw — Clive's primary mind
OPENCLAW_AGENT=clive
OPENCLAW_TIMEOUT=120
OPENCLAW_STATUS_LABEL=Clive is thinking
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_SESSION_USER=clive-voice-v2
CLIVE_FALLBACK_TO_LOCAL_LLM=1

# Claude model for fallback
CLIVE_MODEL=claude-haiku-4-5-20251001

# ---- Server ----

HOST_PORT=3100

# ---- Cloudflare Tunnel (set to 0 to disable) ----
CLOUDFLARE_TUNNEL=0

# ---- Mock modes (set to 1 to test without hardware) ----

MOCK_STT=0
MOCK_TTS=0
MOCK_LLM=0
MOCK_AGENT=0
